# Data (large files)
data/

# Models (ignore large checkpoint files)
models/**/*.pth
models/**/*.pt
models/**/*.npy

# Tools (ffmpeg binaries, mediapipe models - can be re-downloaded)
/tools/
deploy/data_cleaning/*.task

# Archive (old experiment results, notebooks, pkl files)
archive/

# Python
__pycache__/
*.pyc
*.pyo

# Documents (store separately, not in git)
*.docx

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Compressed archives
*.tar.gz
*.zip
*.rar

# Office lock files
~$*

# Kaggle metadata artifact
dataset-metadata.json

# Claude Code project settings
.claude/
